node_modules
out
dist
*.log
.DS_Store
.vite
release
*.spbackup
.npmrc
*.tsbuildinfo

# Tunnel engines are built from source by scripts/build-{sidecar,frpc}.sh.
# The manifest is committed so a clone knows which hashes it expects; the
# binaries themselves are build output.
resources/bin/*
!resources/bin/manifest.json
.frp-build/

# Scratch root for tests that need a directory no other user can write to
# (os.tmpdir() is /tmp on Linux, which the binary resolver correctly refuses).
.tmp-tests/
