# A realistic commercial profile.
; semicolon comments too
client
dev tun
proto udp
remote uk-london.vpn.example.com 1194 udp
remote uk-manchester.vpn.example.com 1194 udp
remote-random
resolv-retry infinite
nobind
persist-key
persist-tun
float
tls-client
remote-cert-tls server
verify-x509-name "C=GB, O=Example, CN=server" subject
auth-user-pass
static-challenge "Enter your 6-digit code" 1
auth-retry nointeract
data-ciphers AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-256-CBC
cipher AES-256-CBC
auth SHA512
tls-version-min 1.2
tls-cipher TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384
reneg-sec 0
ping 10
ping-restart 60
ping-timer-rem
mssfix 1450
tun-mtu 1500
explicit-exit-notify 2
topology subnet
sndbuf 524288
rcvbuf 524288
dhcp-option DNS 10.8.0.1
dhcp-option DOMAIN corp.example.com
route 10.8.0.0 255.255.0.0
redirect-gateway def1 bypass-dhcp
comp-lzo no
mute 20
nice 0
fast-io
verb 11
key-direction 1
setenv FORWARD_COMPATIBLE 1
setenv UV_PLATFORM shellpilot
nonsense-directive whatever
